<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <!-- Twilio's webhooks: /cktwilio/webhook/inbound (replies) and /cktwilio/webhook/status (delivery status) -->
        <route id="cktwilio" frontName="cktwilio">
            <module name="CommerceKings_NotificationTwilio"/>
        </route>
    </router>
</config>
