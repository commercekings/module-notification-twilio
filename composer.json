{
    "name": "commercekings/module-notification-twilio",
    "description": "Twilio SMS and WhatsApp for CommerceKings Notification: two providers, signed reply and status webhooks (STOP/START, undeliverable numbers), the opt-in confirmation, WhatsApp templates and quiet hours in the recipient's time zone.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.4",
        "magento/module-config": "^101.2",
        "magento/module-store": "^101.1",
        "commercekings/module-notification": "^0.1",
        "giggsey/libphonenumber-for-php": "^8.13||^9.0",
        "guzzlehttp/guzzle": "^7.4"
    },
    "suggest": {
        "commercekings/module-rate-limit": "Rate limits for the delivery status webhook (Magento 2.4.7+)"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\NotificationTwilio\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-notification-twilio",
    "support": {
        "issues": "https://github.com/commercekings/module-notification-twilio/issues",
        "source": "https://github.com/commercekings/module-notification-twilio"
    }
}
